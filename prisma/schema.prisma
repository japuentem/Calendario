// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organizacion {
  id         String   @id @default(uuid())
  nombre     String
  pais       String
  region     String
  imagenUrl  String?
  leyenda    String?
  duenos     Dueno[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Dueno {
  id                  String        @id @default(uuid())
  nombre              String
  apellido            String
  puesto              String
  correo              String
  tipo                String        // "DUEÑO_DE_CALENDARIO" | "ASISTENTE_DE_TRANSICION"
  estado              String        @default("ACTIVO") // "ACTIVO" | "AUSENTE_TEMPORAL" | "EN_TRANSICION" | "BAJA"
  fechaInicioAusencia DateTime?
  fechaFinAusencia    DateTime?
  causaAusencia       String?
  organizacionId      String
  organizacion        Organizacion  @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  calendario          Calendario?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Calendario {
  id                 String             @id @default(uuid())
  nombre             String
  duenoId            String             @unique
  dueno              Dueno              @relation(fields: [duenoId], references: [id], onDelete: Cascade)
  permitirInvitados  Boolean            @default(true)
  mensajeCierre      String?
  imagenPresentacion String?
  limitesAgendar     Int                @default(0) // en dias/horas
  limitesCancelar    Int                @default(0)
  limitesReagendar   Int                @default(0)
  tiposEventos       TipoEvento[]
  disponibilidades   Disponibilidad[]
  fechasEspeciales   FechaEspecial[]
  eventos            Evento[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model TipoEvento {
  id                  String     @id @default(uuid())
  nombre              String     // "REALIZAR_LLAMADA" | "RECIBIR_LLAMADA" | "CITA_REUNION" | "VIDEOCONFERENCIA"
  nombrePersonalizado String?    // Nombre personalizado configurable por el dueño (ej: "Atención a Domicilio")
  activo              Boolean    @default(true) // Indica si el evento está disponible para selección de terceros
  duracion            Int        // en minutos, ej: 15, 30, 45, 60, 75, 90
  margenSeguridad     Int        // en minutos, ej: 15, 30, 45
  calendarioId        String
  calendario          Calendario @relation(fields: [calendarioId], references: [id], onDelete: Cascade)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Disponibilidad {
  id           String     @id @default(uuid())
  diaSemana    Int        // 0 (Domingo) a 6 (Sábado)
  horaInicio   String     // "HH:MM"
  horaFin      String     // "HH:MM"
  calendarioId String
  calendario   Calendario @relation(fields: [calendarioId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model FechaEspecial {
  id           String     @id @default(uuid())
  fecha        DateTime
  horaInicio   String     // "HH:MM"
  horaFin      String     // "HH:MM"
  calendarioId String
  calendario   Calendario @relation(fields: [calendarioId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Evento {
  id                String         @id @default(uuid())
  tema              String
  fecha             DateTime
  horaInicio        String         // "HH:MM"
  duracion          Int            // en minutos
  estado            String         @default("PENDIENTE") // "PENDIENTE" | "EJECUTADO"
  archivoAdjuntoUrl String?
  calendarioId      String
  calendario        Calendario     @relation(fields: [calendarioId], references: [id], onDelete: Cascade)
  participantes     Participante[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Participante {
  id        String   @id @default(uuid())
  nombre    String
  apellido  String
  correo    String
  telefono  String?
  esCreador Boolean  @default(false) // true si es el usuario tercero
  eventoId  String
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comunicacion {
  id               String   @id @default(uuid())
  codigo           String   // Ej: COM-001, COMMX-001
  nombre           String   // Ej: CONFIRMACION EVENTO - SOLICITANTE
  pais             String?  @default("México")
  tipoComunicacion String   @default("CORREO") // "CORREO", "WHATSAPP", "MENSAJE"
  tipoActivador    String   // "EVENTO" | "REGLA"
  idActivador      String?  // Ej: CALMX-001
  accionActivador  String?  // Ej: SOLICITUD EVENTO USUARIO, RECORDATORIO SW EVENTO
  horasRelativas   Int?     // Horas antes/después si es por REGLA (Ej: 24)
  incluirFinSemana Boolean  @default(true)
  origen           String   @default("ORGANIZACION")
  segmento         String   @default("TODOS")
  destinatarios    String   // JSON stringified array ej ["SOLICITANTE", "DUEÑO_CALENDARIO"]
  asuntoHeader     String   // Plantilla del Asunto con variables
  mensajeCopy      String   // Plantilla del Mensaje con variables y enlaces CTAs
  variables        String?  // JSON stringified de variables y sus reglas
  enlacesAcciones  String?  // JSON stringified de CTAs
  adjuntos         String?  // JSON stringified de archivos adjuntos
  status           String   @default("ACTIVO") // "ACTIVO" | "NO_ACTIVO"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

